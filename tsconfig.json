{
  "compilerOptions": {
    /* Base Options: */
    "skipLibCheck": true,
    "target": "ESNext",
    "lib": ["ESNext"],

    /* Module system: */
    "esModuleInterop": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /* Strictness: */
    "strict": true,
    "noUncheckedIndexedAccess": true,

    /* Emit */
    "declaration": true,
    "declarationDir": "./dist",

    /* Directory */
    "outDir": "dist",
    "rootDir": "./src"
  },
  "exclude": ["src/**/*.test.ts"],
  "include": ["src/**/*.ts"]
}
