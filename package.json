{
  "name": "to-static-images",
  "version": "1.1.1",
  "description": "CLI tool to batch-convert and resize images (webp, avif, png, jpg) and generate a JSON directory manifest — for static sites and galleries",
  "main": "./dist/index.js",
  "type": "module",
  "bin": "./dist/cli.js",
  "homepage": "https://to-static-images.zvalentin.ru",
  "repository": {
    "type": "git",
    "url": "git@github.com:vdistortion/to-static-images.git"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node ./dist/index.js",
    "build": "rm -rf ./dist && tsc",
    "public:lib": "npm run build && npm publish",
    "format": "prettier . --write",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "typescript",
    "images",
    "image-optimization",
    "image-processing",
    "image-conversion",
    "image-resize",
    "webp",
    "avif",
    "png",
    "jpg",
    "sharp",
    "cli",
    "build-tool",
    "json",
    "json-manifest",
    "static-site",
    "static-assets",
    "manifest",
    "frontend",
    "gallery",
    "jamstack",
    "ssg",
    "batch",
    "resize",
    "npx",
    "to-webp-json"
  ],
  "author": "Valentin <https://github.com/vdistortion>",
  "license": "Apache-2.0",
  "prettier": {
    "singleQuote": true
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "cli-progress": "^3.12.0",
    "commander": "^15.0.0",
    "cosmiconfig": "^9.0.1",
    "directory-structure-json": "^1.0.0",
    "p-limit": "^7.3.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/directory-structure-json": "^1.0.2",
    "@types/node": "^25.9.2",
    "prettier": "3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.8"
  },
  "files": [
    "dist"
  ]
}
