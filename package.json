{
  "name": "image-manifest",
  "version": "2.0.0",
  "description": "CLI tool to batch-convert and resize images (webp, avif, png, jpg) and generate a JSON directory manifest — for static sites and galleries",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./image-processing": {
      "types": "./dist/modules/image-processing.d.ts",
      "import": "./dist/modules/image-processing.js"
    },
    "./is-image": {
      "types": "./dist/modules/is-image.d.ts",
      "import": "./dist/modules/is-image.js"
    },
    "./collect-images": {
      "types": "./dist/modules/collect-images.d.ts",
      "import": "./dist/modules/collect-images.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "type": "module",
  "bin": "./dist/cli.js",
  "homepage": "https://image-manifest.zvalentin.ru",
  "repository": {
    "type": "git",
    "url": "git@github.com:vdistortion/image-manifest.git"
  },
  "scripts": {
    "dev": "DEBUG=image-manifest:* tsx src/cli.ts",
    "start": "DEBUG=image-manifest:* node ./dist/cli.js",
    "build": "rm -rf ./dist && tsc",
    "public:lib": "npm run build && npm publish",
    "format": "prettier . --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings 0",
    "test": "vitest run",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "typescript",
    "images",
    "image-optimization",
    "image-processing",
    "image-conversion",
    "image-resize",
    "webp",
    "avif",
    "png",
    "jpg",
    "sharp",
    "cli",
    "build-tool",
    "json",
    "json-manifest",
    "static-site",
    "static-assets",
    "manifest",
    "frontend",
    "gallery",
    "jamstack",
    "ssg",
    "batch",
    "resize",
    "npx",
    "to-webp-json"
  ],
  "author": "Valentin <https://github.com/vdistortion>",
  "license": "Apache-2.0",
  "prettier": {
    "singleQuote": true
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "cli-progress": "^3.12.0",
    "commander": "^15.0.0",
    "cosmiconfig": "^9.0.1",
    "debug": "^4.4.3",
    "directory-structure-json": "^1.0.0",
    "p-limit": "^7.3.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cli-progress": "^3.11.6",
    "@types/debug": "^4.1.13",
    "@types/directory-structure-json": "^1.0.2",
    "@types/node": "^25.9.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.8"
  },
  "files": [
    "dist"
  ]
}
