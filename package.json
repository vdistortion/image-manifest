{
  "name": "to-static-images",
  "version": "1.1.0",
  "description": "Build optimized static image assets (webp, avif, png, jpg) with optional resize and JSON manifest",
  "main": "./dist/index.js",
  "type": "module",
  "bin": "./dist/index.js",
  "homepage": "https://vdistortion.github.io/to-static-images/",
  "repository": {
    "type": "git",
    "url": "git@github.com:vdistortion/to-static-images.git"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node ./dist/index.js",
    "build": "rimraf ./dist && tsc && tsc-alias",
    "public:lib": "npm run build && npm publish",
    "public:gh-pages": "gh-pages -d docs/.vitepress/dist -t --nojekyll",
    "public": "npm run docs:build && npm run public:gh-pages",
    "format": "prettier . --write",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "typescript",
    "images",
    "image-optimization",
    "image-processing",
    "webp",
    "avif",
    "png",
    "jpg",
    "cli",
    "build-tool",
    "json",
    "static-site",
    "static-assets",
    "manifest",
    "frontend",
    "to-webp-json"
  ],
  "author": "Валентин <valentin.distortion@gmail.com>",
  "license": "GPL",
  "dependencies": {
    "@inquirer/prompts": "^7.9.0",
    "cli-progress": "^3.12.0",
    "directory-structure-json": "^1.0.0",
    "is-image": "^4.0.0",
    "p-limit": "^7.2.0",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/directory-structure-json": "^1.0.2",
    "@types/node": "^24.9.2",
    "gh-pages": "^6.3.0",
    "prettier": "3.6.2",
    "rimraf": "^6.1.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4"
  },
  "types": "./types/index.d.ts",
  "files": [
    "dist",
    "types"
  ]
}
